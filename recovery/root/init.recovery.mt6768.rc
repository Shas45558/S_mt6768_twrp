import /microtrust.rc

on init
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.configfs 1
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    chmod 0666 /dev/isee_tee0
    chmod 0666 /dev/teei_client
    chmod 0777 /tmp/
    chown system system /dev/isee_tee0
    chown system system /dev/teei_client
    mkdir -p /tmp/misc/keystore
    chown keystore:keystore /tmp/misc/keystore
    chmod 0700 /tmp/misc/keystore

on early-fs
    start adbd
    
on fs
    install_keyring
    start servicemanager
    start hwservicemanager
    start vndservicemanager

#
# Recovery startup sequence
#

on property:init.svc.teei_daemon=running
    start keymaster-4-1
    start gatekeeper-1-0


service keystore /vendor/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user keystore
    group keystore readproc log
    task_profiles ProcessCapacityHigh
    # The default memlock limit of 65536 bytes is too low for keystore.
    rlimit memlock unlimited unlimited
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0
    
service keymaster-4-1 /vendor/bin/hw/android.hardware.keymaster@4.1-service.beanpod
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    class early_hal
    user root
    group root drmrpc
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user root
    group root
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:recovery:s0

on property:ro.crypto.state=unsupported
    stop gatekeeper-1-0
    stop keymaster-4-1
    stop teei_daemon
    stop keystore2

on property:ro.crypto.state=unencrypted
    stop gatekeeper-1-0
    stop keymaster-4-1
    stop teei_daemon
    stop keystore2
    
on property:twrp.decrypt.done=true
    stop gatekeeper-1-0
    stop keymaster-4-1
    stop teei_daemon
    stop keystore2